{
  "name": "ds_adls_orders_parquet",
  "properties": {
    "linkedServiceName": {
      "referenceName": "ls_adls",
      "type": "LinkedServiceReference"
    },
    "parameters": {
      "container": {
        "type": "String"
      },
      "folder": {
        "type": "String"
      },
      "file": {
        "type": "String"
      }
    },
    "type": "Parquet",
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "fileSystem": {
          "value": "@dataset().container",
          "type": "Expression"
        },
        "folderPath": {
          "value": "@dataset().folder",
          "type": "Expression"
        },
        "fileName": {
          "value": "@dataset().file",
          "type": "Expression"
        }
      },
      "compressionCodec": "snappy"
    }
  }
}
